generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal placeholder model to satisfy Prisma Client generator
// No business entities will be added until later blocks.
model Placeholder {
  id Int @id
}
