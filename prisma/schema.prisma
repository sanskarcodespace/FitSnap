// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  context   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("CLIENT") // "COACH" or "CLIENT"
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coachProfile CoachProfile?

  coachConnections  CoachClientConnection[] @relation("CoachConnections")
  clientConnections CoachClientConnection[] @relation("ClientConnections")

  clientProfile ClientProfile?
  meals         MealLog[]       @relation("ClientMeals")
  waterLogs     WaterLogEntry[] @relation("ClientWater")
  workouts      WorkoutLog[]    @relation("ClientWorkouts")
  yogaLogs         YogaLog[]              @relation("ClientYogaLogs")
  weightEntries    WeightEntry[]          @relation("ClientWeight")
  bodyMeasurements BodyMeasurementEntry[] @relation("ClientBodyMeasurements")
  progressPhotos   ProgressPhotoEntry[]   @relation("ClientProgressPhotos")
  habitCompletions HabitCompletion[]      @relation("ClientHabitCompletions")
  habitPlans       HabitPlan[]            @relation("ClientHabitPlans")
  checkIns      DailyCheckIn[] @relation("ClientCheckIns")
  sentMessages  Message[]      @relation("SentMessages")

  notifications      Notification[]
  verificationTokens VerificationToken[]
  aiConversation     AIConversation?
  sessions           Session[]
}

model CoachProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String?
  bio          String?
  specialties  String[] // Array of strings (e.g., "YOGA", "STRENGTH")
  credentials  String?
  profilePhoto String? // Path or URL to the photo
  timezone     String   @default("UTC")

  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?

  emailOnNewMessage Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal                String?
  currentWeight       Float?
  targetWeight             Float?
  preferredWeightUnit      String    @default("kg")
  preferredMeasurementUnit String    @default("cm")
  height              Float?
  targetDate          DateTime?
  profilePhoto        String?

  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?

  timezone                       String  @default("UTC")
  habitReminderEnabled           Boolean @default(false)
  habitReminderHour              Int?
  lastHabitReminderSentDate      String?
  monthlyReportNotificationEnabled Boolean @default(true)
  lastMonthlyReportNotifiedMonth String?
  emailOnNewMessage              Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoachClientConnection {
  id String @id @default(cuid())

  coachId String
  coach   User   @relation("CoachConnections", fields: [coachId], references: [id], onDelete: Cascade)

  clientId String?
  client   User?   @relation("ClientConnections", fields: [clientId], references: [id], onDelete: SetNull)

  invitedEmail    String
  invitedName     String?
  personalMessage String?

  invitationToken       String   @unique
  invitationTokenExpiry DateTime
  status                String   @default("PENDING") // PENDING, ACTIVE, CANCELLED, ENDED

  invitedAt     DateTime  @default(now())
  acceptedAt    DateTime?
  endedAt       DateTime?
  endedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nutritionTarget NutritionTarget?
  conversation    Conversation?
  dietPlans       DietPlan[]
  workoutPlans    WorkoutPlan[]
  yogaPlans       YogaPlan[]
  habitPlans      HabitPlan[]           @relation("ConnectionHabitPlans")

  @@index([coachId, status])
  @@index([clientId, status])
  @@index([invitedEmail])
}

model DietPlan {
  id                      String                @id @default(cuid())
  coachClientConnectionId String
  connection              CoachClientConnection @relation(fields: [coachClientConnectionId], references: [id], onDelete: Cascade)

  title    String
  overview String?
  status   String  @default("ACTIVE") // "ACTIVE" | "ARCHIVED"

  mealGuidance DietPlanMealGuidance[]
  guidelines   DietPlanGuideline[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([coachClientConnectionId, status])
}

model DietPlanMealGuidance {
  id         String   @id @default(cuid())
  dietPlanId String
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)

  mealType     String // "Breakfast" | "Lunch" | "Dinner" | "Snack"
  customLabel  String?
  guidanceText String

  @@index([dietPlanId])
}

model DietPlanGuideline {
  id         String   @id @default(cuid())
  dietPlanId String
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)

  text      String
  createdAt DateTime @default(now())

  @@index([dietPlanId])
}

model NutritionTarget {
  id           String                @id @default(cuid())
  connectionId String                @unique
  connection   CoachClientConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  calorieTarget      Int
  proteinTargetGrams Int
  carbTargetGrams    Int
  fatTargetGrams     Int
  waterTargetLiters  Float
  fiberTargetGrams   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MealLog {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation("ClientMeals", fields: [clientId], references: [id], onDelete: Cascade)

  date           String // Stored as YYYY-MM-DD for easy querying without timezone shifts
  mealType       String // "Breakfast", "Lunch", "Dinner", "Snack"
  source         String  @default("manual") // Extensibility point for future AI
  photoReference String? // Path to securely stored private image

  foodItems FoodItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, date(sort: Desc)])
}

model FoodItem {
  id        String  @id @default(cuid())
  mealLogId String
  mealLog   MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  name               String
  portionDescription String?
  originType         String  @default("manual") // "manual" | "ai_detected"

  calories     Int
  proteinGrams Int  @default(0)
  carbGrams    Int  @default(0)
  fatGrams     Int  @default(0)
  fiberGrams   Int  @default(0)
  sugarGrams   Int?
  sodiumMg     Int?

  @@index([mealLogId])
}

model WaterLogEntry {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation("ClientWater", fields: [clientId], references: [id], onDelete: Cascade)

  date     String // YYYY-MM-DD
  amountMl Int
  loggedAt DateTime @default(now())

  @@index([clientId, date(sort: Desc)])
}

model WorkoutPlan {
  id                      String                @id @default(cuid())
  coachClientConnectionId String
  connection              CoachClientConnection @relation(fields: [coachClientConnectionId], references: [id], onDelete: Cascade)

  title    String
  overview String?
  status   String  @default("ACTIVE") // "ACTIVE" | "ARCHIVED"

  sessions   WorkoutPlanSession[]
  guidelines WorkoutPlanGuideline[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([coachClientConnectionId, status])
}

model WorkoutPlanSession {
  id            String      @id @default(cuid())
  workoutPlanId String
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  name        String
  description String?
  sortOrder   Int

  exercises WorkoutPlanExercise[]

  @@index([workoutPlanId])
}

model WorkoutPlanExercise {
  id                   String             @id @default(cuid())
  workoutPlanSessionId String
  workoutPlanSession   WorkoutPlanSession @relation(fields: [workoutPlanSessionId], references: [id], onDelete: Cascade)

  name                String
  setsRepsDescription String?
  notes               String?
  sortOrder           Int

  @@index([workoutPlanSessionId])
}

model WorkoutPlanGuideline {
  id            String      @id @default(cuid())
  workoutPlanId String
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  text      String
  createdAt DateTime @default(now())

  @@index([workoutPlanId])
}

model WorkoutLog {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation("ClientWorkouts", fields: [clientId], references: [id], onDelete: Cascade)

  date            String // YYYY-MM-DD
  title           String
  category        String // "Strength", "Cardio", "Sports", "Other"
  durationMinutes Int?
  notes           String?
  source          String @default("custom") // "plan" | "custom"
  linkedWorkoutPlanSessionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, date(sort: Desc)])
}

model YogaPlan {
  id                      String                @id @default(cuid())
  coachClientConnectionId String
  connection              CoachClientConnection @relation(fields: [coachClientConnectionId], references: [id], onDelete: Cascade)

  title    String
  overview String?
  status   String  @default("ACTIVE") // "ACTIVE" | "ARCHIVED"

  sequences  YogaPlanSequence[]
  guidelines YogaPlanGuideline[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([coachClientConnectionId, status])
}

model YogaPlanSequence {
  id               String   @id @default(cuid())
  yogaPlanId       String
  yogaPlan         YogaPlan @relation(fields: [yogaPlanId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  style            String?  // "Hatha" | "Vinyasa" | "Yin" | "Restorative" | "Power" | "Other"
  durationGuidance String?
  sortOrder        Int

  poses            YogaPlanPose[]

  @@index([yogaPlanId])
}

model YogaPlanPose {
  id                 String           @id @default(cuid())
  yogaPlanSequenceId String
  yogaPlanSequence   YogaPlanSequence @relation(fields: [yogaPlanSequenceId], references: [id], onDelete: Cascade)

  name               String
  holdOrRepGuidance  String?
  notes              String?
  sortOrder          Int

  @@index([yogaPlanSequenceId])
}

model YogaPlanGuideline {
  id         String   @id @default(cuid())
  yogaPlanId String
  yogaPlan   YogaPlan @relation(fields: [yogaPlanId], references: [id], onDelete: Cascade)

  text      String
  createdAt DateTime @default(now())

  @@index([yogaPlanId])
}

model YogaLog {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation("ClientYogaLogs", fields: [clientId], references: [id], onDelete: Cascade)

  date                     String // YYYY-MM-DD
  title                    String
  style                    String // "Hatha" | "Vinyasa" | "Yin" | "Restorative" | "Power" | "Other"
  durationMinutes          Int?
  notes                    String?
  source                   String @default("custom") // "plan" | "custom"
  linkedYogaPlanSequenceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, date(sort: Desc)])
}

model WeightEntry {
  id          String   @id @default(cuid())
  clientId    String
  client      User     @relation("ClientWeight", fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime // YYYY-MM-DD representing the log date
  weightValue Float
  weightUnit  String
  note        String?
  createdAt   DateTime @default(now())

  @@index([clientId, date(sort: Desc)])
}

model BodyMeasurementEntry {
  id              String   @id @default(cuid())
  clientId        String
  client          User     @relation("ClientBodyMeasurements", fields: [clientId], references: [id], onDelete: Cascade)
  date            DateTime // YYYY-MM-DD representing the log date
  waistValue      Float?
  chestValue      Float?
  hipsValue       Float?
  armsValue       Float?
  thighsValue     Float?
  measurementUnit String
  note            String?
  createdAt       DateTime @default(now())

  @@index([clientId, date(sort: Desc)])
}

model ProgressPhotoEntry {
  id             String   @id @default(cuid())
  clientId       String
  client         User     @relation("ClientProgressPhotos", fields: [clientId], references: [id], onDelete: Cascade)
  
  date           String // YYYY-MM-DD
  photoReference String // Path to securely stored private image
  angle          String? // "Front" | "Side" | "Back" | "Other"
  note           String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId, date(sort: Desc)])
}

model HabitPlan {
  id                      String               @id @default(cuid())
  coachClientConnectionId String?
  connection              CoachClientConnection? @relation("ConnectionHabitPlans", fields: [coachClientConnectionId], references: [id], onDelete: Cascade)
  
  clientId                String?
  client                  User?                @relation("ClientHabitPlans", fields: [clientId], references: [id], onDelete: Cascade)

  title                   String
  overview                String?
  status                  String               // "ACTIVE" | "ARCHIVED"
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  archivedAt              DateTime?

  items                   HabitPlanItem[]
  guidelines              HabitPlanGuideline[]

  @@index([coachClientConnectionId, status])
}

model HabitPlanItem {
  id                  String            @id @default(cuid())
  habitPlanId         String
  habitPlan           HabitPlan         @relation(fields: [habitPlanId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  targetFrequency     String            // "Daily" | "TimesPerWeek" | "NoSpecificTarget"
  targetTimesPerWeek  Int?
  sortOrder           Int
  status              String            // "active" | "removed"

  completions         HabitCompletion[]

  @@index([habitPlanId])
}

model HabitPlanGuideline {
  id          String    @id @default(cuid())
  habitPlanId String
  habitPlan   HabitPlan @relation(fields: [habitPlanId], references: [id], onDelete: Cascade)
  text        String
  createdAt   DateTime  @default(now())

  @@index([habitPlanId])
}

model HabitCompletion {
  id                 String        @id @default(cuid())
  clientId           String
  client             User          @relation("ClientHabitCompletions", fields: [clientId], references: [id], onDelete: Cascade)
  habitPlanItemId    String
  habitPlanItem      HabitPlanItem @relation(fields: [habitPlanItemId], references: [id], onDelete: Cascade)
  habitNameSnapshot  String
  date               String        // YYYY-MM-DD
  note               String?
  createdAt          DateTime      @default(now())

  @@index([clientId, date(sort: Desc)])
  @@index([habitPlanItemId, date(sort: Desc)])
}

model DailyCheckIn {
  id         String   @id @default(cuid())
  clientId   String
  date       String   // YYYY-MM-DD
  sleepHours Float?
  steps      Int?
  mood       Int?     // 1-5
  energy     Int?     // 1-5
  note       String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  client     User     @relation("ClientCheckIns", fields: [clientId], references: [id])

  @@unique([clientId, date])
}

model Conversation {
  id                      String                @id @default(cuid())
  coachClientConnectionId String                @unique
  connection              CoachClientConnection @relation(fields: [coachClientConnectionId], references: [id], onDelete: Cascade)

  status                  String                @default("ACTIVE") // "ACTIVE" | "ARCHIVED"

  lastMessageEmailSentAt  DateTime?

  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  archivedAt              DateTime?

  messages                Message[]

  @@index([coachClientConnectionId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  body           String       @db.Text
  
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId])
  @@index([senderId])
}

model Notification {
  id           String    @id @default(cuid())
  clientId     String
  client       User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type         String    // "HABIT_REMINDER" | "MONTHLY_REPORT_READY"
  message      String
  relatedMonth String?   // "YYYY-MM"
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([clientId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}


model AIConversation {
  id        String       @id @default(cuid())
  clientId  String       @unique
  client    User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  messages  AIMessage[]
}

enum AISender {
  CLIENT
  ASSISTANT
}

model AIMessage {
  id               String         @id @default(cuid())
  aiConversationId String
  conversation     AIConversation @relation(fields: [aiConversationId], references: [id], onDelete: Cascade)
  sender           AISender
  body             String         @db.Text
  createdAt        DateTime       @default(now())

  @@index([aiConversationId])
}

model AuditLogEntry {
  id               String   @id @default(cuid())
  actorUserId      String?
  actorRole        String?
  eventType        String
  targetUserId     String?
  metadata         String?  @db.Text
  ipAddressPartial String?
  createdAt        DateTime @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([eventType])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  userAgent        String?
  ipAddressPartial String?
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}
