# Never commit real credentials. Copy to .env.local for local development.
DATABASE_URL="postgresql://postgres:password@localhost:5432/fitsnap?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: photo food-name suggestions. Nutrition is always confirmed separately.
GEMINI_API_KEY=""
GEMINI_FOOD_MODEL="gemini-2.5-flash"
# Optional: USDA general-food search. Open Food Facts requires no API key.
USDA_API_KEY=""
# Development only. Production ignores mock food recognition.
MOCK_AI="false"
EMAIL_DRIVER="console"
